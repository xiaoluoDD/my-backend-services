# 复制为 .env 后填写真实值（.env 不要提交到 Git）
#
# 命令行测试:  cd wecom && set -a && source .env && set +a && go run .
# HTTP 服务:   cd http && set -a && source ../wecom/.env && set +a && go run .
#              Qt 看板调用 POST http://<服务器IP>:8080/api/wecom/test

WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_AGENT_ID=1000005
WECOM_SECRET=your_app_secret_here
WECOM_TO_USER=YourUserId
