# 复制为 .env 后填写真实值（.env 不要提交到 Git）
#
# 命令行测试:  cd wecom && set -a && source .env && set +a && go run .
# HTTP 服务:   cd http && set -a && source ../wecom/.env && set +a && go run .
#              默认端口 8081（8080 若已被 echohttp 占用）；Qt 看板:
#              POST http://<服务器IP>:8081/api/wecom/test

HTTP_PORT=8081

# 日志：写入 logs/ 目录（默认 logs/http.log）；排查时可 tail -f logs/http.log
# LOG_LEVEL=info          # debug | info | warn | error
# LOG_DIR=logs            # 设为空字符串则仅输出到控制台
# LOG_DAILY=true          # 按天分割：http-2026-05-27.log

WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_AGENT_ID=1000005
WECOM_SECRET=your_app_secret_here
WECOM_TO_USER=YourUserId
